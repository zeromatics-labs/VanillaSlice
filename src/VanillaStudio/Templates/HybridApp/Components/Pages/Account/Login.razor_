@page "/account/login"
@using Microsoft.AspNetCore.Components.Authorization
@using {{ProjectName}}.ClientShared.Identity
@inject MauiAuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>Sign in</PageTitle>

{{#if (eq UIFramework "Bootstrap")}}
<div class="container" style="max-width: 26rem;">
    <h1 class="h3 mb-4">Sign in</h1>

    @if (!string.IsNullOrEmpty(error))
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }

    <EditForm Model="this" OnValidSubmit="SignInAsync" FormName="login">
        <div class="mb-3">
            <label class="form-label" for="email">Email</label>
            <InputText id="email" class="form-control" @bind-Value="email" autocomplete="username" />
        </div>
        <div class="mb-3">
            <label class="form-label" for="password">Password</label>
            <InputText id="password" type="password" class="form-control"
                       @bind-Value="password" autocomplete="current-password" />
        </div>
        <button class="btn btn-primary w-100" type="submit" disabled="@busy">
            @(busy ? "Signing in…" : "Sign in")
        </button>
    </EditForm>

    <div class="mt-3 d-flex justify-content-between">
        <a href="/account/register">Create an account</a>
        <a href="/account/forgot-password">Forgot password?</a>
    </div>
</div>
{{/if}}

{{#if (eq UIFramework "FluentUI")}}
<div class="account-container" style="max-width: 26rem; margin: 0 auto;">
    <FluentLabel Typo="Typography.H4" Class="mb-3">Sign in</FluentLabel>

    @if (!string.IsNullOrEmpty(error))
    {
        <FluentMessageBar Intent="MessageIntent.Error" Class="mb-3">@error</FluentMessageBar>
    }

    <EditForm Model="this" OnValidSubmit="SignInAsync" FormName="login">
        <div class="mb-3">
            <FluentTextField @bind-Value="email" Label="Email" Placeholder="Email" Required="true" Class="w-100" />
        </div>
        <div class="mb-3">
            <FluentTextField @bind-Value="password" Label="Password" TextFieldType="TextFieldType.Password" Required="true" Class="w-100" />
        </div>
        <FluentButton Type="ButtonType.Submit" Appearance="Appearance.Accent" Disabled="@busy" Class="w-100">
            @(busy ? "Signing in…" : "Sign in")
        </FluentButton>
    </EditForm>

    <div class="mt-3 d-flex justify-content-between">
        <a href="/account/register">Create an account</a>
        <a href="/account/forgot-password">Forgot password?</a>
    </div>
</div>
{{/if}}

{{#if (eq UIFramework "MudBlazor")}}
<MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="mt-4">
    <MudText Typo="Typo.h4" Class="mb-4">Sign in</MudText>

    @if (!string.IsNullOrEmpty(error))
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@error</MudAlert>
    }

    <EditForm Model="this" OnValidSubmit="SignInAsync" FormName="login">
        <MudTextField @bind-Value="email" Label="Email" Variant="Variant.Outlined" Class="mb-3" FullWidth="true" />
        <MudTextField @bind-Value="password" Label="Password" InputType="InputType.Password" Variant="Variant.Outlined" Class="mb-3" FullWidth="true" />
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="@busy" FullWidth="true">
            @(busy ? "Signing in…" : "Sign in")
        </MudButton>
    </EditForm>

    <div class="d-flex justify-space-between mt-3">
        <MudLink Href="/account/register">Create an account</MudLink>
        <MudLink Href="/account/forgot-password">Forgot password?</MudLink>
    </div>
</MudContainer>
{{/if}}

{{#if (eq UIFramework "Radzen")}}
<div class="rz-p-4" style="max-width: 26rem; margin: 0 auto;">
    <RadzenText TextStyle="TextStyle.H4" Class="rz-mb-4">Sign in</RadzenText>

    @if (!string.IsNullOrEmpty(error))
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" Class="rz-mb-4">@error</RadzenAlert>
    }

    <EditForm Model="this" OnValidSubmit="SignInAsync" FormName="login">
        <div class="rz-mb-3">
            <RadzenLabel Text="Email" Component="email" />
            <RadzenTextBox Name="email" @bind-Value="email" Style="width: 100%;" />
        </div>
        <div class="rz-mb-3">
            <RadzenLabel Text="Password" Component="password" />
            <RadzenPassword Name="password" @bind-Value="password" Style="width: 100%;" />
        </div>
        <RadzenButton ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary" Disabled="@busy" Style="width: 100%;">
            @(busy ? "Signing in…" : "Sign in")
        </RadzenButton>
    </EditForm>

    <div class="rz-mt-3 rz-display-flex rz-justify-content-space-between">
        <a href="/account/register">Create an account</a>
        <a href="/account/forgot-password">Forgot password?</a>
    </div>
</div>
{{/if}}

{{#if (eq UIFramework "TailwindCSS")}}
<div class="max-w-sm mx-auto px-4 py-6">
    <h1 class="text-2xl font-bold text-gray-900 mb-4">Sign in</h1>

    @if (!string.IsNullOrEmpty(error))
    {
        <div class="flex items-center p-4 bg-red-50 border border-red-200 rounded-lg mb-4" role="alert">
            <span class="text-red-800">@error</span>
        </div>
    }

    <EditForm Model="this" OnValidSubmit="SignInAsync" FormName="login">
        <div class="mb-4">
            <label for="email" class="form-label">Email</label>
            <InputText id="email" class="form-control" @bind-Value="email" autocomplete="username" />
        </div>
        <div class="mb-4">
            <label for="password" class="form-label">Password</label>
            <InputText id="password" type="password" class="form-control"
                       @bind-Value="password" autocomplete="current-password" />
        </div>
        <button type="submit" disabled="@busy"
                class="w-full px-6 py-2 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 disabled:opacity-50 disabled:cursor-not-allowed transition-colors">
            @(busy ? "Signing in…" : "Sign in")
        </button>
    </EditForm>

    <div class="mt-4 flex justify-between text-sm">
        <a class="text-blue-600 hover:text-blue-700" href="/account/register">Create an account</a>
        <a class="text-blue-600 hover:text-blue-700" href="/account/forgot-password">Forgot password?</a>
    </div>
</div>
{{/if}}

@code {
    private string email = string.Empty;
    private string password = string.Empty;
    private string? error;
    private bool busy;

    private async Task SignInAsync()
    {
        busy = true;
        error = null;

        var result = await AuthStateProvider.LogInAsync(email, password);

        busy = false;

        if (!result.Succeeded)
        {
            error = result.Error ?? "Sign in failed. Check your email and password.";
            return;
        }

        Navigation.NavigateTo("");
    }
}
