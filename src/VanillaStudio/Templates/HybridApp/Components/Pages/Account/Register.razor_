@page "/account/register"
@using {{ProjectName}}.ClientShared.Identity
@inject MauiAuthenticationStateProvider AuthStateProvider

<PageTitle>Create account</PageTitle>

{{#if (eq UIFramework "Bootstrap")}}
<div class="container" style="max-width: 26rem;">
    @if (registered)
    {
        <h1 class="h3 mb-3">Check your email</h1>
        <p>
            We sent a confirmation link to <strong>@email</strong>.
            Confirm your address, then <a href="/account/login">sign in</a>.
        </p>
    }
    else
    {
        <h1 class="h3 mb-4">Create account</h1>

        @if (!string.IsNullOrEmpty(error))
        {
            <div class="alert alert-danger" role="alert">@error</div>
        }

        <EditForm Model="this" OnValidSubmit="RegisterAsync" FormName="register">
            <div class="mb-3">
                <label class="form-label" for="email">Email</label>
                <InputText id="email" class="form-control" @bind-Value="email" autocomplete="username" />
            </div>
            <div class="mb-3">
                <label class="form-label" for="password">Password</label>
                <InputText id="password" type="password" class="form-control"
                           @bind-Value="password" autocomplete="new-password" />
            </div>
            <button class="btn btn-primary w-100" type="submit" disabled="@busy">
                @(busy ? "Creating…" : "Create account")
            </button>
        </EditForm>

        <div class="mt-3"><a href="/account/login">Already have an account?</a></div>
    }
</div>
{{/if}}

{{#if (eq UIFramework "FluentUI")}}
<div class="account-container" style="max-width: 26rem; margin: 0 auto;">
    @if (registered)
    {
        <FluentLabel Typo="Typography.H4" Class="mb-3">Check your email</FluentLabel>
        <FluentLabel Typo="Typography.Body">
            We sent a confirmation link to <strong>@email</strong>.
            Confirm your address, then <a href="/account/login">sign in</a>.
        </FluentLabel>
    }
    else
    {
        <FluentLabel Typo="Typography.H4" Class="mb-3">Create account</FluentLabel>

        @if (!string.IsNullOrEmpty(error))
        {
            <FluentMessageBar Intent="MessageIntent.Error" Class="mb-3">@error</FluentMessageBar>
        }

        <EditForm Model="this" OnValidSubmit="RegisterAsync" FormName="register">
            <div class="mb-3">
                <FluentTextField @bind-Value="email" Label="Email" Placeholder="Email" Required="true" Class="w-100" />
            </div>
            <div class="mb-3">
                <FluentTextField @bind-Value="password" Label="Password" TextFieldType="TextFieldType.Password" Required="true" Class="w-100" />
            </div>
            <FluentButton Type="ButtonType.Submit" Appearance="Appearance.Accent" Disabled="@busy" Class="w-100">
                @(busy ? "Creating…" : "Create account")
            </FluentButton>
        </EditForm>

        <div class="mt-3"><a href="/account/login">Already have an account?</a></div>
    }
</div>
{{/if}}

{{#if (eq UIFramework "MudBlazor")}}
<MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="mt-4">
    @if (registered)
    {
        <MudText Typo="Typo.h4" Class="mb-3">Check your email</MudText>
        <MudText Typo="Typo.body1">
            We sent a confirmation link to <strong>@email</strong>.
            Confirm your address, then <MudLink Href="/account/login">sign in</MudLink>.
        </MudText>
    }
    else
    {
        <MudText Typo="Typo.h4" Class="mb-4">Create account</MudText>

        @if (!string.IsNullOrEmpty(error))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@error</MudAlert>
        }

        <EditForm Model="this" OnValidSubmit="RegisterAsync" FormName="register">
            <MudTextField @bind-Value="email" Label="Email" Variant="Variant.Outlined" Class="mb-3" FullWidth="true" />
            <MudTextField @bind-Value="password" Label="Password" InputType="InputType.Password" Variant="Variant.Outlined" Class="mb-3" FullWidth="true" />
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="@busy" FullWidth="true">
                @(busy ? "Creating…" : "Create account")
            </MudButton>
        </EditForm>

        <div class="mt-3"><MudLink Href="/account/login">Already have an account?</MudLink></div>
    }
</MudContainer>
{{/if}}

{{#if (eq UIFramework "Radzen")}}
<div class="rz-p-4" style="max-width: 26rem; margin: 0 auto;">
    @if (registered)
    {
        <RadzenText TextStyle="TextStyle.H4" Class="rz-mb-3">Check your email</RadzenText>
        <RadzenText TextStyle="TextStyle.Body1">
            We sent a confirmation link to <strong>@email</strong>.
            Confirm your address, then <a href="/account/login">sign in</a>.
        </RadzenText>
    }
    else
    {
        <RadzenText TextStyle="TextStyle.H4" Class="rz-mb-4">Create account</RadzenText>

        @if (!string.IsNullOrEmpty(error))
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" Class="rz-mb-4">@error</RadzenAlert>
        }

        <EditForm Model="this" OnValidSubmit="RegisterAsync" FormName="register">
            <div class="rz-mb-3">
                <RadzenLabel Text="Email" Component="email" />
                <RadzenTextBox Name="email" @bind-Value="email" Style="width: 100%;" />
            </div>
            <div class="rz-mb-3">
                <RadzenLabel Text="Password" Component="password" />
                <RadzenPassword Name="password" @bind-Value="password" Style="width: 100%;" />
            </div>
            <RadzenButton ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary" Disabled="@busy" Style="width: 100%;">
                @(busy ? "Creating…" : "Create account")
            </RadzenButton>
        </EditForm>

        <div class="rz-mt-3"><a href="/account/login">Already have an account?</a></div>
    }
</div>
{{/if}}

{{#if (eq UIFramework "TailwindCSS")}}
<div class="max-w-sm mx-auto px-4 py-6">
    @if (registered)
    {
        <h1 class="text-2xl font-bold text-gray-900 mb-3">Check your email</h1>
        <p class="text-gray-700">
            We sent a confirmation link to <strong>@email</strong>.
            Confirm your address, then <a class="text-blue-600 hover:text-blue-700" href="/account/login">sign in</a>.
        </p>
    }
    else
    {
        <h1 class="text-2xl font-bold text-gray-900 mb-4">Create account</h1>

        @if (!string.IsNullOrEmpty(error))
        {
            <div class="flex items-center p-4 bg-red-50 border border-red-200 rounded-lg mb-4" role="alert">
                <span class="text-red-800">@error</span>
            </div>
        }

        <EditForm Model="this" OnValidSubmit="RegisterAsync" FormName="register">
            <div class="mb-4">
                <label for="email" class="form-label">Email</label>
                <InputText id="email" class="form-control" @bind-Value="email" autocomplete="username" />
            </div>
            <div class="mb-4">
                <label for="password" class="form-label">Password</label>
                <InputText id="password" type="password" class="form-control"
                           @bind-Value="password" autocomplete="new-password" />
            </div>
            <button type="submit" disabled="@busy"
                    class="w-full px-6 py-2 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 disabled:opacity-50 disabled:cursor-not-allowed transition-colors">
                @(busy ? "Creating…" : "Create account")
            </button>
        </EditForm>

        <div class="mt-4 text-sm"><a class="text-blue-600 hover:text-blue-700" href="/account/login">Already have an account?</a></div>
    }
</div>
{{/if}}

@code {
    private string email = string.Empty;
    private string password = string.Empty;
    private string? error;
    private bool busy;
    private bool registered;

    private async Task RegisterAsync()
    {
        busy = true;
        error = null;

        var result = await AuthStateProvider.RegisterAsync(email, password);

        busy = false;

        if (!result.Succeeded)
        {
            error = result.Error ?? "Registration failed.";
            return;
        }

        // Confirmation is required — do not sign in here.
        registered = true;
    }
}
