@page "/account/forgot-password"
@using {{ProjectName}}.ClientShared.Identity
@inject IdentityClient IdentityClient

<PageTitle>Reset password</PageTitle>

{{#if (eq UIFramework "Bootstrap")}}
<div class="container" style="max-width: 26rem;">
    @if (sent)
    {
        <h1 class="h3 mb-3">Check your email</h1>
        <p>
            If an account exists for <strong>@email</strong>, we sent a reset link.
            Opening it will complete the reset in your browser.
        </p>
    }
    else
    {
        <h1 class="h3 mb-4">Reset password</h1>

        <EditForm Model="this" OnValidSubmit="RequestAsync" FormName="forgot-password">
            <div class="mb-3">
                <label class="form-label" for="email">Email</label>
                <InputText id="email" class="form-control" @bind-Value="email" autocomplete="username" />
            </div>
            <button class="btn btn-primary w-100" type="submit" disabled="@busy">
                @(busy ? "Sending…" : "Send reset link")
            </button>
        </EditForm>

        <div class="mt-3"><a href="/account/login">Back to sign in</a></div>
    }
</div>
{{/if}}

{{#if (eq UIFramework "FluentUI")}}
<div class="account-container" style="max-width: 26rem; margin: 0 auto;">
    @if (sent)
    {
        <FluentLabel Typo="Typography.H4" Class="mb-3">Check your email</FluentLabel>
        <FluentLabel Typo="Typography.Body">
            If an account exists for <strong>@email</strong>, we sent a reset link.
            Opening it will complete the reset in your browser.
        </FluentLabel>
    }
    else
    {
        <FluentLabel Typo="Typography.H4" Class="mb-3">Reset password</FluentLabel>

        <EditForm Model="this" OnValidSubmit="RequestAsync" FormName="forgot-password">
            <div class="mb-3">
                <FluentTextField @bind-Value="email" Label="Email" Placeholder="Email" Required="true" Class="w-100" />
            </div>
            <FluentButton Type="ButtonType.Submit" Appearance="Appearance.Accent" Disabled="@busy" Class="w-100">
                @(busy ? "Sending…" : "Send reset link")
            </FluentButton>
        </EditForm>

        <div class="mt-3"><a href="/account/login">Back to sign in</a></div>
    }
</div>
{{/if}}

{{#if (eq UIFramework "MudBlazor")}}
<MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="mt-4">
    @if (sent)
    {
        <MudText Typo="Typo.h4" Class="mb-3">Check your email</MudText>
        <MudText Typo="Typo.body1">
            If an account exists for <strong>@email</strong>, we sent a reset link.
            Opening it will complete the reset in your browser.
        </MudText>
    }
    else
    {
        <MudText Typo="Typo.h4" Class="mb-4">Reset password</MudText>

        <EditForm Model="this" OnValidSubmit="RequestAsync" FormName="forgot-password">
            <MudTextField @bind-Value="email" Label="Email" Variant="Variant.Outlined" Class="mb-3" FullWidth="true" />
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="@busy" FullWidth="true">
                @(busy ? "Sending…" : "Send reset link")
            </MudButton>
        </EditForm>

        <div class="mt-3"><MudLink Href="/account/login">Back to sign in</MudLink></div>
    }
</MudContainer>
{{/if}}

{{#if (eq UIFramework "Radzen")}}
<div class="rz-p-4" style="max-width: 26rem; margin: 0 auto;">
    @if (sent)
    {
        <RadzenText TextStyle="TextStyle.H4" Class="rz-mb-3">Check your email</RadzenText>
        <RadzenText TextStyle="TextStyle.Body1">
            If an account exists for <strong>@email</strong>, we sent a reset link.
            Opening it will complete the reset in your browser.
        </RadzenText>
    }
    else
    {
        <RadzenText TextStyle="TextStyle.H4" Class="rz-mb-4">Reset password</RadzenText>

        <EditForm Model="this" OnValidSubmit="RequestAsync" FormName="forgot-password">
            <div class="rz-mb-3">
                <RadzenLabel Text="Email" Component="email" />
                <RadzenTextBox Name="email" @bind-Value="email" Style="width: 100%;" />
            </div>
            <RadzenButton ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary" Disabled="@busy" Style="width: 100%;">
                @(busy ? "Sending…" : "Send reset link")
            </RadzenButton>
        </EditForm>

        <div class="rz-mt-3"><a href="/account/login">Back to sign in</a></div>
    }
</div>
{{/if}}

{{#if (eq UIFramework "TailwindCSS")}}
<div class="max-w-sm mx-auto px-4 py-6">
    @if (sent)
    {
        <h1 class="text-2xl font-bold text-gray-900 mb-3">Check your email</h1>
        <p class="text-gray-700">
            If an account exists for <strong>@email</strong>, we sent a reset link.
            Opening it will complete the reset in your browser.
        </p>
    }
    else
    {
        <h1 class="text-2xl font-bold text-gray-900 mb-4">Reset password</h1>

        <EditForm Model="this" OnValidSubmit="RequestAsync" FormName="forgot-password">
            <div class="mb-4">
                <label for="email" class="form-label">Email</label>
                <InputText id="email" class="form-control" @bind-Value="email" autocomplete="username" />
            </div>
            <button type="submit" disabled="@busy"
                    class="w-full px-6 py-2 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 disabled:opacity-50 disabled:cursor-not-allowed transition-colors">
                @(busy ? "Sending…" : "Send reset link")
            </button>
        </EditForm>

        <div class="mt-4 text-sm"><a class="text-blue-600 hover:text-blue-700" href="/account/login">Back to sign in</a></div>
    }
</div>
{{/if}}

@code {
    private string email = string.Empty;
    private bool busy;
    private bool sent;

    private async Task RequestAsync()
    {
        busy = true;
        await IdentityClient.ForgotPasswordAsync(email);
        busy = false;

        // Always report success — never reveal whether an account exists.
        sent = true;
    }
}
