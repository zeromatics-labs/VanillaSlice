{
  "ConnectionStrings": {
{{#if (eq DatabaseProvider "SqlServer")}}
    "DefaultConnection": "Server=(local);Database={{ProjectName}};Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True;"
{{/if}}
{{#if (eq DatabaseProvider "PostgreSQL")}}
    "DefaultConnection": "Host=localhost;Database={{ProjectName}};Username=postgres;Password=postgres"
{{/if}}
{{#if (eq DatabaseProvider "SQLite")}}
    "DefaultConnection": "Data Source={{ProjectName}}.db"
{{/if}}
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
