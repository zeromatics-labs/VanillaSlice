<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="{{ProjectName}}.MauiNativeApp.Features.Account.ForgotPasswordPage"
             Title="Forgot password"
             Shell.NavBarIsVisible="True">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16" VerticalOptions="Center">
            <Label Text="Forgot password" FontSize="28" FontAttributes="Bold" />

            <VerticalStackLayout x:Name="FormLayout" Spacing="16">
                <Label Text="Enter your email and we'll send you a reset link if an account exists." />
                <Entry x:Name="EmailEntry" Placeholder="Email" Keyboard="Email" />

                <Button x:Name="SendButton" Text="Send reset link" Clicked="OnSendClicked" />
            </VerticalStackLayout>

            <Label x:Name="ConfirmationLabel" IsVisible="False" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
